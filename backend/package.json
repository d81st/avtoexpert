{
  "name": "avtoexpert-pro-backend",
  "version": "1.0.0",
  "description": "AvtoExpert Pro backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:full": "npm run docker:db:up && npm run dev",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest --run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docker:db:up": "wsl sh -lc \"docker compose -f /mnt/c/Users/speed/Projects/avtoexpert-pro/backend/docker-compose.yml up -d postgres\"",
    "docker:db:down": "wsl sh -lc \"docker compose -f /mnt/c/Users/speed/Projects/avtoexpert-pro/backend/docker-compose.yml down\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docxtemplater": "^3.68.7",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "pizzip": "^3.2.0",
    "sharp": "^0.34.5",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.21",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "xmldom": "npm:@xmldom/xmldom@^0.8.10"
  },
  "private": true
}
